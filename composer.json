{
	"name": "afcd/afcd-core-development",
	"description": "The Andrea WP core development plugin.",
	"license": "MIT",
	"type": "project",
	"homepage": "https://github.com/afercia",
	"require": {
		"php": "^8.0"
	},
	"require-dev": {
		"composer/ca-bundle": "1.5.12",
		"squizlabs/php_codesniffer": "3.13.5",
		"wp-coding-standards/wpcs": "~3.3.0",
		"phpcompatibility/phpcompatibility-wp": "~2.1.3",
		"phpstan/phpstan": "2.2.2",
		"symfony/var-dumper": "^4.4",
		"yoast/phpunit-polyfills": "^1.1.0",
		"php-stubs/wordpress-stubs": "^7.0"
	},
	"minimum-stability": "dev",
	"prefer-stable": true,
	"autoload": {
		"classmap": [
			"includes/"
		]
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		},
		"lock": false
	},
	"scripts": {
		"phpstan": "@php ./vendor/bin/phpstan analyse --memory-limit=2G",
		"compat": "@php ./vendor/squizlabs/php_codesniffer/bin/phpcs --standard=phpcompat.xml.dist --report=summary,source",
		"format": "@php ./vendor/squizlabs/php_codesniffer/bin/phpcbf --report=summary,source",
		"lint": "@php ./vendor/squizlabs/php_codesniffer/bin/phpcs --standard=phpcs.xml.dist --report=full -s",
		"lint:errors": "@lint -n"
	}
}
